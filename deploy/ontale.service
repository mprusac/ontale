# /etc/systemd/system/ontale.service
[Unit]
Description=ONTALE.eu
After=network.target

[Service]
Type=simple
User=ontale
WorkingDirectory=/opt/ontale
EnvironmentFile=/opt/ontale/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ontale/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
